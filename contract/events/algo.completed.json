{
  "$defs": {
    "AlgoOperator": {
      "description": "Algo 算子标识，与镜像名一一对应（架构文档第二节模块4）。",
      "enum": [
        "preannotate",
        "quality",
        "keyframe",
        "anomaly"
      ],
      "title": "AlgoOperator",
      "type": "string"
    }
  },
  "$id": "https://robotdatahub.local/events/algo.completed.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``algo.completed`` —— 单个算子执行成功。\n\n发布方：Scheduler algo-worker。\n消费方：Scheduler notify-worker（聚合后回调 Platform，交互⑧）。",
  "properties": {
    "episode_id": {
      "description": "Episode ID",
      "title": "Episode Id",
      "type": "string"
    },
    "event_id": {
      "description": "事件唯一 ID（UUID），消费方据此幂等去重",
      "title": "Event Id",
      "type": "string"
    },
    "job_id": {
      "description": "作业 ID",
      "title": "Job Id",
      "type": "string"
    },
    "model_version": {
      "description": "模型版本（镜像 tag）",
      "title": "Model Version",
      "type": "string"
    },
    "occurred_at": {
      "description": "事件发生时间（UTC）",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "operator": {
      "$ref": "#/$defs/AlgoOperator",
      "description": "算子类型"
    },
    "output_prefix": {
      "description": "产物的 MinIO 前缀",
      "title": "Output Prefix",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "跨模块链路追踪 ID",
      "title": "Trace Id"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "episode_id",
    "job_id",
    "operator",
    "model_version",
    "output_prefix"
  ],
  "title": "AlgoCompleted",
  "type": "object",
  "x-contract": {
    "consumer_queue": "notify",
    "description": "单个算子执行成功，聚合后回调 Platform",
    "exchange": "robotdatahub.events",
    "max_retries": 3,
    "routing_key": "algo.completed",
    "version": "0.1.0"
  }
}
