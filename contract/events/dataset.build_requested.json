{
  "$id": "https://robotdatahub.local/events/dataset.build_requested.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``dataset.build_requested`` —— Lab 工作区请求构建训练集。\n\n发布方：Platform（Lab 工作区）。\n消费方：Scheduler tool-worker。",
  "properties": {
    "dataset_id": {
      "description": "训练集 ID",
      "title": "Dataset Id",
      "type": "string"
    },
    "episode_ids": {
      "description": "纳入的 Episode",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Episode Ids",
      "type": "array"
    },
    "event_id": {
      "description": "事件唯一 ID（UUID），消费方据此幂等去重",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "description": "事件发生时间（UTC）",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "output_format": {
      "description": "导出格式，如 lerobot / rlds",
      "title": "Output Format",
      "type": "string"
    },
    "requested_by": {
      "description": "发起人 user_id",
      "title": "Requested By",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "跨模块链路追踪 ID",
      "title": "Trace Id"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "dataset_id",
    "episode_ids",
    "output_format",
    "requested_by"
  ],
  "title": "DatasetBuildRequested",
  "type": "object",
  "x-contract": {
    "consumer_queue": "tool",
    "description": "Lab 请求构建训练集",
    "exchange": "robotdatahub.events",
    "max_retries": 3,
    "routing_key": "dataset.build_requested",
    "version": "0.1.0"
  }
}
