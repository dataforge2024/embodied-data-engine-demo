# 本地开发环境变量模板。
#
#   cp .env.example .env
#
# `.env` 已在 .gitignore 里 —— 仓库是 public，真实凭据不得入库。
# 下面的值只够本地 demo 用；生产环境这些必须换掉，Platform 启动时的
# `assert_production_ready()` 会拦住带默认值上生产的情况。

# ---- RabbitMQ（docker-compose 起 broker 用）----
RABBITMQ_USER=rdh
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- 队列后端 ----
# file   = 本地文件队列，零外部依赖（make demo 默认）
# rabbit = 真 broker（make demo-rabbit）
# Platform 与 Scheduler 必须设成同一个值，否则一边发一边收不到。
RDH_QUEUE_BACKEND=file

# 连接串里的用户名密码要与上面的 RABBITMQ_USER / RABBITMQ_PASSWORD 一致。
RDH_AMQP_URL=amqp://rdh:change-me-local-only@127.0.0.1:5672/

# ---- 服务凭据 ----
# 本地 demo 的默认值，生产必须显式覆盖。
RDH_JWT_SECRET=local-dev-only-not-a-real-secret
RDH_AGENT_TOKEN=local-agent-token
RDH_SCHEDULER_TOKEN=local-scheduler-token
